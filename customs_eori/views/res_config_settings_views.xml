<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base.eori</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <settings id="eu_service" position="after">
                <settings
                    id="eori_service"
                    title="EORI Number Validation"
                    help="Verify EORI numbers using the lookup service. If enabled, contacts with invalid EORI numbers cannot be saved.">
                    <field name="eori_validation"/>
                </settings>
            </settings>
        </field>
    </record>
</odoo>
