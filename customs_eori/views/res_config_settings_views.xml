<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base.eori</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <div class="o_setting_box" id="eori_service_box">
                    <div class="o_setting_left_pane">
                        <field name="eori_validation"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="eori_validation" string="EORI Number Validation"/>
                        <div class="text-muted">
                            Verify EORI numbers using the EU/HMRC lookup service.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
